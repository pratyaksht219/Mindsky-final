# AI Gateway Environment Variables
# Copy this file to .env and fill in your values

# MongoDB (leave blank to use in-memory DB for local dev)
MONGO_URI=

# JWT
JWT_SECRET=your_jwt_secret_here

# AI Gateway — fill these in to enable AI scoring and chat
AI_GATEWAY_URL=https://your-ai-endpoint.com/api
AI_GATEWAY_KEY=your_api_key_here

# Server
PORT=5001

# Twilio (For sending real crisis text messages)

# Backend Api's
AI_URL_START=http://localhost:8080/api/gateway/start
AI_URL_ANSWER=http://localhost:8080/api/gateway/answer
CALL_API_URL=http://localhost:8084/crisis/call?to=%2B91
SMS_API_URL=http://localhost:8084/crisis/sendSms?to=%2B91