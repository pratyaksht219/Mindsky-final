      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q20"
      }
    },
    {
      "id": "dass21_q21",
      "text": "I felt that life was meaningless",
      "domain": "depression",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q21"
      }
