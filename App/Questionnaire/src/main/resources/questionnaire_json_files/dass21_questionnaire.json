      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q17"
      }
    },
    {
      "id": "dass21_q18",
      "text": "I felt that I was rather touchy",
      "domain": "stress",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q18"
      }
    },
    {
      "id": "dass21_q19",
      "text": "I was aware of the action of my heart in the absence of physical exertion",
      "domain": "anxiety",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q19"
      }
    },
    {
      "id": "dass21_q20",
      "text": "I felt scared without any good reason",
