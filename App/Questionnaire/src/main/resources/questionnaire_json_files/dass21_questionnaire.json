{
  "id": "dass21",
  "name": "Depression Anxiety Stress Scales – 21 Items",
  "short_name": "DASS-21",
  "category": "mental_health",
  "description": "A 21-item self-report questionnaire designed to measure the negative emotional states of depression, anxiety, and stress over the past week.",
  "version": "Short Form (21 items)",
  "source": "Lovibond & Lovibond (1995)",
  "instructions": "Please read each statement and select how much the statement applied to you over the past week.",

  "questions": [
    {
      "id": "dass21_q1",
      "text": "I found it hard to wind down",
      "domain": "stress",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q1"
      }
    },
    {
      "id": "dass21_q2",
      "text": "I was aware of dryness of my mouth",
      "domain": "anxiety",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q2"
      }
    },
    {
      "id": "dass21_q3",
      "text": "I couldn’t seem to experience any positive feeling at all",
      "domain": "depression",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q3"
      }
    },
    {
      "id": "dass21_q4",
      "text": "I experienced breathing difficulty (e.g., excessively rapid breathing, breathlessness in the absence of physical exertion)",
      "domain": "anxiety",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q4"
      }
    },
    {
      "id": "dass21_q5",
      "text": "I found it difficult to work up the initiative to do things",
      "domain": "depression",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q5"
      }
    },
    {
      "id": "dass21_q6",
      "text": "I tended to over-react to situations",
      "domain": "stress",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q6"
      }
    },
    {
      "id": "dass21_q7",
      "text": "I experienced trembling (e.g., in the hands)",
      "domain": "anxiety",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3",
        "response_key": "dass21_q7"
      }
    },
    {
      "id": "dass21_q8",
      "text": "I felt that I was using a lot of nervous energy",
