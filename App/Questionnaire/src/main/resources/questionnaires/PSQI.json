{
  "id": "psqi",
  "name": "Pittsburgh Sleep Quality Index",
  "short_name": "PSQI",
  "category": "sleep",
  "description": "A self-rated questionnaire assessing sleep quality and disturbances over a 1-month time interval.",
  "version": "Original",
  "source": "Buysse et al., 1989, University of Pittsburgh",
  "instructions": "The following questions relate to your usual sleep habits during the past month only. Your answers should indicate the most accurate reply for the majority of days and nights in the past month.",
  "response_format": {
    "type": "mixed",
    "scales": {
      "likert_0_3": [
        {
          "label": "Not during the past month",
          "value": 0
        },
        {
          "label": "Less than once a week",
          "value": 1
        },
        {
          "label": "Once or twice a week",
          "value": 2
        },
        {
          "label": "Three or more times a week",
          "value": 3
        }
      ],
      "quality_0_3": [
        {
          "label": "Very good",
          "value": 0
        },
        {
          "label": "Fairly good",
          "value": 1
        },
        {
          "label": "Fairly bad",
          "value": 2
        },
        {
          "label": "Very bad",
          "value": 3
        }
      ]
    }
  },
  "questions": [
    {
      "id": "psqi_q1",
      "text": "During the past month, what time have you usually gone to bed at night?",
      "response_format": {
        "type": "time"
      }
    },
    {
      "id": "psqi_q2",
      "text": "During the past month, how long (in minutes) has it usually taken you to fall asleep each night?",
      "response_format": {
        "type": "number",
        "unit": "minutes",
        "min": 0
      }
    },
    {
      "id": "psqi_q3",
      "text": "During the past month, what time have you usually gotten up in the morning?",
      "response_format": {
        "type": "time"
      }
    },
    {
      "id": "psqi_q4",
      "text": "During the past month, how many hours of actual sleep did you get at night?",
      "response_format": {
        "type": "number",
        "unit": "hours",
        "min": 0,
        "max": 24
      }
    },
    {
      "id": "psqi_q5a",
      "text": "Cannot get to sleep within 30 minutes",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5b",
      "text": "Wake up in the middle of the night or early morning",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5c",
      "text": "Have to get up to use the bathroom",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5d",
      "text": "Cannot breathe comfortably",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5e",
      "text": "Cough or snore loudly",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5f",
      "text": "Feel too cold",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5g",
      "text": "Feel too hot",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5h",
      "text": "Had bad dreams",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q5i",
      "text": "Have pain",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q6",
      "text": "During the past month, how would you rate your sleep quality overall?",
      "response_format": {
        "type": "scale",
        "scale": "quality_0_3"
      }
    },
    {
      "id": "psqi_q7",
      "text": "During the past month, how often have you taken medicine to help you sleep?",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q8",
      "text": "During the past month, how often have you had trouble staying awake while driving, eating meals, or engaging in social activity?",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    },
    {
      "id": "psqi_q9",
      "text": "During the past month, how much of a problem has it been for you to keep up enough enthusiasm to get things done?",
      "response_format": {
        "type": "scale",
        "scale": "likert_0_3"
      }
    }
  ],
  "scoring": {
    "method": "component_based",
    "components": [
      {
        "name": "Subjective Sleep Quality",
        "question_ids": [
          "psqi_q6"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Sleep Latency",
        "question_ids": [
          "psqi_q2",
          "psqi_q5a"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Sleep Duration",
        "question_ids": [
          "psqi_q4"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Habitual Sleep Efficiency",
        "question_ids": [
          "psqi_q1",
          "psqi_q3",
          "psqi_q4"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Sleep Disturbances",
        "question_ids": [
          "psqi_q5b",
          "psqi_q5c",
          "psqi_q5d",
          "psqi_q5e",
          "psqi_q5f",
          "psqi_q5g",
          "psqi_q5h",
          "psqi_q5i"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Use of Sleeping Medication",
        "question_ids": [
          "psqi_q7"
        ],
        "score_range": [
          0,
          3
        ]
      },
      {
        "name": "Daytime Dysfunction",
        "question_ids": [
          "psqi_q8",
          "psqi_q9"
        ],
        "score_range": [
          0,
          3
        ]
      }
    ],
    "global_score_range": [
      0,
      21
    ],
    "cutoff": {
      "poor_sleep_quality": 5
    }
  },
  "interpretation": {
    "note": "A global PSQI score greater than 5 indicates poor sleep quality.",
    "global_cutoff": 5
  },
  "metadata": {
    "estimated_time_minutes": 5,
    "clinical_use": true,
    "license": "© University of Pittsburgh, non-commercial research and clinical use"
  }
}