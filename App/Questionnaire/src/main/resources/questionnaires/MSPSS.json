{
  "id": "mspss",
  "name": "Multidimensional Scale of Perceived Social Support",
  "short_name": "MSPSS",
  "category": "Social Support",
  "description": "A 12-item scale designed to measure perceptions of support from three sources: Family, Friends, and a Significant Other.",
  "version": "1988",
  "source": "Zimet, Dahlem, Zimet & Farley (1988)",
  "instructions": "Read each statement carefully. Indicate how you feel about each statement using the 7-point scale.",
