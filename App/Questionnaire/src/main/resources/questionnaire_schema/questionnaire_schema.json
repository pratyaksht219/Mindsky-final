{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/questionnaire.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "short_name",
    "category",
    "description",
    "version",
    "source",
    "instructions",
    "questions",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique questionnaire identifier (e.g., phq9, gad7, lsas)"
    },
    "name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "response_format"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique question identifier"
          },
          "text": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "description": "Optional domain/subscale classification (e.g., performance, interaction)"
          },
          "response_format": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "scale",
                  "dual_scale",
                  "number",
                  "time",
                  "boolean",
                  "text"
                ]
              },
              "response_key": {
                "type": "string",
                "description": "Key under which the response value is stored (e.g., value, hours, minutes)"
              },
              "scale": {
                "type": "string",
                "description": "Scale ID for single-scale questions"
              },
              "response_keys": {
                "type": "object",
                "minProperties": 2,
                "additionalProperties": {
                  "type": "string",
                  "description": "Maps response_key → scale_id"
                },
                "description": "Used for multi-value responses (e.g., fear + avoidance)"
              },
              "unit": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "allow_decimal": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "scale"
                    }
                  }
                },
                "then": {
                  "required": [
                    "scale",
                    "response_key"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "dual_scale"
                    }
                  }
                },
                "then": {
                  "required": [
                    "response_keys"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "number"
                    }
                  }
                },
                "then": {
                  "required": [
                    "response_key",
                    "min"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "time"
                    }
                  }
                },
                "then": {
                  "required": [
                    "response_key"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "boolean"
                    }
                  }
                },
                "then": {
                  "required": [
                    "response_key"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "text"
                    }
                  }
                },
                "then": {
                  "required": [
                    "response_key"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "estimated_time_minutes",
        "clinical_use",
        "license"
      ],
      "properties": {
        "estimated_time_minutes": {
          "type": "number"
        },
        "clinical_use": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}